          "required": false
        },
        {
          "key": "period",
          "type": "select",
          "label": {
            "en": "Period of the tops",
            "fr": "Période des tops"
          },
          "options": [
            {
              "value": "7day",
              "label": {
                "en": "Last 7 days",
                "fr": "7 derniers jours"
              }
            },
            {
              "value": "1month",
              "label": {
                "en": "Last month",
                "fr": "Dernier mois"
              }
            },
            {
              "value": "3month",
              "label": {
