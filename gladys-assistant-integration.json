                "fr": "3 derniers mois"
              }
            },
            {
              "value": "6month",
              "label": {
                "en": "Last 6 months",
                "fr": "6 derniers mois"
              }
            },
            {
              "value": "12month",
              "label": {
                "en": "Last 12 months",
                "fr": "12 derniers mois"
              }
            },
            {
              "value": "overall",
              "label": {
                "en": "All time",
                "fr": "Depuis toujours"
              }
            }
          ],
          "default": "7day",
          "required": false
        }
