            "fr": "Coup de cœur"
          }
        },
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "Last.fm link",
            "fr": "Lien Last.fm"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Summary",
            "fr": "Résumé"
          },
          "description": {
            "en": "A sentence ready to put in a message.",
