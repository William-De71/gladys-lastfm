{
  "manifest_version": 1,
  "type": "device",
  "name": "Last.fm",
  "description": {
    "en": "What you listen to on Last.fm: scrobbles, music scenes and widgets.",
    "fr": "Vos écoutes Last.fm : scrobbles, scènes musicales et widgets."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/william-de71/gladys-lastfm:1.0.0",
  "gladys_version": ">=5.1.1",
  "categories": ["multimedia"],
  "cover_image": "https://raw.githubusercontent.com/William-De71/gladys-lastfm/main/cover.jpg",
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Last.fm API key",
        "fr": "Clé d’API Last.fm"
      },
      "description": {
        "en": "Last.fm records what you listen to on Spotify, Deezer, Apple Music, YouTube Music, Plex and many more. Reading your listening needs a free API key: create an API account on Last.fm (any application name; the callback URL can stay empty), then copy its API key and shared secret below.",
        "fr": "Last.fm enregistre ce que vous écoutez sur Spotify, Deezer, Apple Music, YouTube Music, Plex et bien d’autres. Lire vos écoutes nécessite une clé d’API gratuite : créez un compte d’API sur Last.fm (nom d’application libre ; l’URL de callback peut rester vide), puis copiez ci-dessous sa clé d’API et son secret partagé."
      },
      "links": [
        {
          "url": "https://www.last.fm/api/account/create",
          "label": {
            "en": "Create an API account",
            "fr": "Créer un compte d’API"
          }
        },
        {
          "url": "https://www.last.fm/api/accounts",
          "label": {
            "en": "My API accounts",
            "fr": "Mes comptes d’API"
          }
        }
      ]
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé d’API"
      },
      "description": {
        "en": "32 characters.",
        "fr": "32 caractères."
      },
      "required": true
    },
    {
      "key": "shared_secret",
      "type": "secret",
      "label": {
        "en": "Shared secret",
        "fr": "Secret partagé"
      },
      "description": {
        "en": "Only needed to link an account (to love tracks).",
        "fr": "Nécessaire uniquement pour lier un compte (aimer des titres)."
      },
      "required": false
    },
    {
      "key": "usernames",
      "type": "string",
      "label": {
        "en": "Profiles to follow",
        "fr": "Profils à suivre"
      },
      "description": {
        "en": "Last.fm usernames, separated by commas (10 at most). Each one becomes a device on the Discovery screen.",
        "fr": "Noms d’utilisateur Last.fm, séparés par des virgules (10 au maximum). Chacun devient un appareil dans l’écran de découverte."
      },
      "placeholder": {
        "en": "rj, my_friend",
        "fr": "rj, mon_ami"
      },
      "required": true
    },
    {
      "key": "poll_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de lecture (s)"
      },
      "description": {
        "en": "How often the profiles are read, between 15 and 300 seconds. Last.fm has no push: this is the delay of the scenes.",
        "fr": "Fréquence de lecture des profils, entre 15 et 300 secondes. Last.fm ne pousse rien : c’est le délai de réaction des scènes."
      },
      "min": 15,
      "max": 300,
      "default": 30,
      "required": false
    },
    {
      "key": "account_intro",
      "type": "section",
      "label": {
        "en": "Link your account (optional)",
        "fr": "Lier votre compte (optionnel)"
      },
      "description": {
        "en": "Only needed to love or unlove tracks from Gladys (widget button, scene actions). Fill in the shared secret and save first, then click Connect and approve the access on the Last.fm page that opens. Gladys detects the approval within a few seconds.",
        "fr": "Nécessaire uniquement pour aimer ou ne plus aimer des titres depuis Gladys (bouton du widget, actions de scène). Renseignez d’abord le secret partagé et enregistrez, puis cliquez sur Connecter et autorisez l’accès sur la page Last.fm qui s’ouvre. Gladys détecte l’autorisation en quelques secondes."
      }
    },
    {
      "key": "account",
      "type": "account_link",
      "label": {
        "en": "Last.fm account",
        "fr": "Compte Last.fm"
      }
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "description": {
        "en": "Checks the API key and reads every followed profile.",
        "fr": "Vérifie la clé d’API et lit chaque profil suivi."
      },
      "timeout_seconds": 60
    },
    {
      "key": "unlink_account",
      "label": {
        "en": "Unlink the account",
        "fr": "Délier le compte"
      },
      "description": {
        "en": "Forgets the session of the linked Last.fm account.",
        "fr": "Oublie la session du compte Last.fm lié."
      },
      "timeout_seconds": 15
    }
  ],
  "scene_triggers": [
    {
      "key": "track_started",
      "label": {
        "en": "Last.fm: new track",
        "fr": "Last.fm : nouveau titre"
      },
      "description": {
        "en": "A profile starts playing a track. Checked every 30 seconds by default.",
        "fr": "Un profil commence à écouter un titre. Vérifié toutes les 30 secondes par défaut."
      },
      "fields": [
        {
          "key": "user",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Profile",
            "fr": "Profil"
          },
          "description": {
            "en": "One of the Last.fm devices. Leave empty for any profile.",
            "fr": "Un des appareils Last.fm. Laissez vide pour tous les profils."
          },
          "required": false
        },
        {
          "key": "artist",
          "type": "string",
          "label": {
            "en": "Artist",
            "fr": "Artiste"
          },
          "description": {
            "en": "Exactly as Last.fm spells it (case-sensitive). Leave empty for any artist.",
            "fr": "Exactement comme Last.fm l’écrit (majuscules comprises). Laissez vide pour tous les artistes."
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "user_name",
          "type": "string",
          "label": {
            "en": "Username",
            "fr": "Nom d’utilisateur"
          }
        },
